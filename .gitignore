# Compiled class file
*.class

# Log file
*.log

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Environment files (frontend/backend)
.env
.env.local
.env.*.local
.local.env
.env.production
.env.development
.env.test

# Node / package manager auth files
.npmrc
.yarnrc
.yarnrc.yml
.pnpmrc

# Service account / cloud keys / secrets
serviceAccount*.json
*credentials*.json
*-credentials.json
*.secret.json
*.google-services.json
GoogleService-Info.plist

# Mobile / keystore / certificates
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
*.crt
*.der
android/**/keystore.*
ios/**/secrets.*

# Docker / registry / CI credentials
.docker/config.json
.netrc
# CI token files
ci-secrets.*
circleci/*.yml

# Infra & cloud state / creds
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.backup
.terraform/
.aws/
*.gcloud.json
.azure/

# Kubernetes configs
.kube/
kubeconfig
kubeconfig.yaml

# Database files and backups
*.sqlite3
*.sqlite3-journal
*.db
*.sql
*.dump
*.bak

# SSH private keys
id_rsa
id_dsa
id_ecdsa
id_ed25519
# (avoid ignoring public keys "*.pub" unless intentional)

# Framework-specific secrets
config/master.key
config/credentials.yml.enc
config/secrets.yml
config/secrets.yml.key

# Fastlane / mobile tooling secrets
fastlane/credentials.json
fastlane/ApiKeys.json
fastlane/**/private_key.json

# Misc sensitive logs / debug files
npm-debug.log*
yarn-error.log*
firebase-debug.log

